{
  "name": "m-date-sim",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --outdir dist",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "imessage": "bun src/imessage.ts",
    "imessage:dev": "bun --watch src/imessage.ts"
  },
  "dependencies": {
    "spacetimedb": "2.10.*",
    "spectrum-ts": "^12.10.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun": "^1.3.2",
    "typescript": "~5.6.2"
  }
}
